{
  "name": "phantom-troupe",
  "version": "1.1.0",
  "description": "A local, multi-agent graveyard for your terminal. Captures failed commands, buries dead scripts, resurrects the ones you still need. Runs open-weight models on your machine.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "phantom": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "webui",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "node --test test/*.test.ts",
    "eval": "node scripts/eval-coroner.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@mastra/core": "^1.81.0",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@mastra/libsql": "^1.28.0",
    "@mastra/memory": "^1.40.0",
    "@sentry/node": "^11.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
